{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnizon Search Results Page Schema",
  "type": "object",
  "$defs": {
    "siteSectionTitle": {
      "type": "string",
      "description": "Titles of the visible content sections on the main page",
      "enum": [
        "Top categories in Kitchen appliances",
        "Gift for People!",
        "Shop for your home essentials",
        "Home d\u00e9cor under $50",
        "Refresh your space",
        "Shop deals in Fashion",
        "Get your game on",
        "Beauty steals under $25",
        "Top sellers in Kitchen",
        "Level up your beauty routine",
        "Wireless Tech",
        "Fantastic Finds for Home",
        "Explore more in Sports",
        "Top sellers in Technology"
      ]
    },
    "topNavCategoryName": {
      "type": "string",
      "enum": [
        "Gift",
        "Toy",
        "Home",
        "Gaming",
        "Cosmetic",
        "Headphones",
        "Coffee",
        "Kitchen"
      ]
    },
    "homeLogoLink": {
      "type": "object",
      "description": "Clickable Omnizon logo that navigates to the main page",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Home"
        },
        "opensPage": {
          "const": "main"
        }
      },
      "required": [
        "ariaLabel",
        "opensPage"
      ]
    },
    "deliveryLocationButton": {
      "type": "object",
      "description": "Clickable delivery location area showing recipient and city",
      "x-visibleCount": 1,
      "properties": {
        "labelLine1": {
          "type": "string",
          "const": "Deliver to"
        },
        "recipientName": {
          "type": "string"
        },
        "city": {
          "type": "string",
          "examples": [
            "DALY CITY"
          ]
        }
      },
      "required": [
        "labelLine1",
        "recipientName",
        "city"
      ]
    },
    "searchTextInput": {
      "type": "object",
      "description": "Main search text input field in the header",
      "x-visibleCount": 1,
      "properties": {
        "type": {
          "const": "text"
        },
        "invalid": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ]
    },
    "searchSubmitButton": {
      "type": "object",
      "description": "Search icon button that submits the header search",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Search"
        },
        "invalid": {
          "type": "boolean"
        },
        "opensPage": {
          "const": "search_results"
        }
      },
      "required": [
        "ariaLabel"
      ]
    },
    "returnsAndOrdersLink": {
      "type": "object",
      "description": "Header link for Returns & Orders",
      "x-visibleCount": 1,
      "properties": {
        "line1": {
          "const": "Returns"
        },
        "line2": {
          "const": "& Orders"
        },
        "opensPage": {
          "const": "returns_and_orders"
        }
      },
      "required": [
        "line1",
        "line2"
      ]
    },
    "shoppingCartLink": {
      "type": "object",
      "description": "Header shopping cart control that opens the cart page",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Shopping Cart"
        },
        "itemCountLabel": {
          "type": "string",
          "examples": [
            "Cart has 0 items"
          ]
        },
        "label": {
          "const": "Cart"
        },
        "opensPage": {
          "const": "cart"
        }
      },
      "required": [
        "ariaLabel",
        "label"
      ]
    },
    "topNavCategoryLink": {
      "type": "object",
      "description": "Top navigation bar category labels (Gift, Toy, Home, etc.) that are visually separate clickable areas",
      "x-visibleCount": 8,
      "x-visibleCounts": {
        "Gift": 1,
        "Toy": 1,
        "Home": 1,
        "Gaming": 1,
        "Cosmetic": 1,
        "Headphones": 1,
        "Coffee": 1,
        "Kitchen": 1
      },
      "properties": {
        "categoryName": {
          "$ref": "#/$defs/topNavCategoryName"
        },
        "opensPage": {
          "const": "search_results"
        }
      },
      "required": [
        "categoryName"
      ]
    },
    "priceRangeSlider": {
      "type": "object",
      "description": "Draggable slider control for selecting minimum or maximum price in the sidebar filter",
      "x-visibleCount": 2,
      "properties": {
        "name": {
          "const": "price"
        },
        "role": {
          "const": "slider"
        },
        "currentValue": {
          "type": "number"
        },
        "minValue": {
          "type": "number"
        },
        "maxValue": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "role",
        "currentValue",
        "minValue",
        "maxValue"
      ]
    },
    "priceGoButton": {
      "type": "object",
      "description": "Button labeled 'GO' that applies the selected price range",
      "x-visibleCount": 1,
      "properties": {
        "text": {
          "const": "Go"
        }
      },
      "required": [
        "text"
      ]
    },
    "colorFilterSwatch": {
      "type": "object",
      "description": "Clickable color square in the Color filter section",
      "x-visibleCount": 14,
      "properties": {
        "sectionTitle": {
          "type": "string",
          "const": "Color"
        },
        "colorName": {
          "type": "string"
        }
      },
      "required": [
        "sectionTitle",
        "colorName"
      ]
    },
    "brandFilterCheckbox": {
      "type": "object",
      "description": "Checkbox for selecting a brand under the Brands filter",
      "x-visibleCount": 8,
      "properties": {
        "sectionTitle": {
          "type": "string",
          "const": "Brands"
        },
        "brandName": {
          "type": "string",
          "enum": [
            "VILVA",
            "KTC",
            "Sony",
            "Xbox",
            "Thermaltake",
            "Playstation",
            "HyperX",
            "SAMSUNG"
          ]
        },
        "checked": {
          "type": "boolean"
        }
      },
      "required": [
        "sectionTitle",
        "brandName",
        "checked"
      ]
    },
    "brandSeeMoreLink": {
      "type": "object",
      "description": "Text link '\u25bc See more' under Brands filter to expand more brands",
      "x-visibleCount": 1,
      "properties": {
        "sectionTitle": {
          "type": "string",
          "const": "Brands"
        },
        "text": {
          "const": "\u25bc See more"
        }
      },
      "required": [
        "sectionTitle",
        "text"
      ]
    },
    "specialFeatureFilterCheckbox": {
      "type": "object",
      "description": "Checkbox for selecting a special feature under the Special Feature filter",
      "x-visibleCount": 9,
      "properties": {
        "sectionTitle": {
          "type": "string",
          "const": "Special Feature"
        },
        "featureLabel": {
          "type": "string",
          "enum": [
            "S Pen Included",
            "Gaming Ready",
            "Long Battery Life",
            "Slim Metal Design",
            "Expandable Storage",
            "Compatible with multiple platforms including Xbox and Windows.",
            "Door Lock",
            "Adjustable Shelves"
          ]
        },
        "checked": {
          "type": "boolean"
        }
      },
      "required": [
        "sectionTitle",
        "featureLabel",
        "checked"
      ]
    },
    "specialFeatureSeeMoreLink": {
      "type": "object",
      "description": "Text link '\u25bc See more' under Special Feature filter to expand more options",
      "x-visibleCount": 1,
      "properties": {
        "sectionTitle": {
          "type": "string",
          "const": "Special Feature"
        },
        "text": {
          "const": "\u25bc See more"
        }
      },
      "required": [
        "sectionTitle",
        "text"
      ]
    },
    "resultsProductCard": {
      "type": "object",
      "description": "Clickable product tiles in the search results grid",
      "x-visibleCount": 12,
      "properties": {
        "brandName": {
          "type": "string"
        },
        "productTitle": {
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        },
        "boughtInPastMonthLabel": {
          "type": "string"
        },
        "ratingValue": {
          "type": "number"
        },
        "ratingCount": {
          "type": "integer"
        },
        "priceWhole": {
          "type": "string"
        },
        "priceFraction": {
          "type": "string"
        },
        "deliveryText": {
          "type": "string"
        },
        "sellerRatingSummary": {
          "type": "string"
        },
        "opensPage": {
          "const": "product_details"
        }
      },
      "required": [
        "productTitle",
        "imageAlt",
        "opensPage"
      ]
    },
    "resultsPriceDetailsLink": {
      "type": "object",
      "description": "Clickable price area within each product card that navigates to the product details page",
      "x-visibleCount": 12,
      "properties": {
        "priceWhole": {
          "type": "string"
        },
        "priceFraction": {
          "type": "string"
        },
        "opensPage": {
          "const": "product_details"
        }
      },
      "required": [
        "priceWhole",
        "opensPage"
      ]
    },
    "resultsAddToCartButton": {
      "type": "object",
      "description": "Yellow 'Add to cart' button on each product card",
      "x-visibleCount": 12,
      "properties": {
        "text": {
          "const": "Add to cart"
        },
        "ariaLabel": {
          "type": "string"
        },
        "invalid": {
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ]
    }
  }
}