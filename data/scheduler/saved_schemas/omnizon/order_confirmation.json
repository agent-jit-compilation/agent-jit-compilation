{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnizon Order Confirmation Page",
  "type": "object",
  "properties": {},
  "$defs": {
    "homeLogoLink": {
      "type": "object",
      "description": "Clickable Omnizon logo that navigates to the main page",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Home"
        },
        "opensPage": {
          "const": "main"
        }
      },
      "required": [
        "ariaLabel",
        "opensPage"
      ]
    },
    "deliveryLocationButton": {
      "type": "object",
      "description": "Clickable delivery location area showing recipient and city",
      "x-visibleCount": 1,
      "properties": {
        "labelLine1": {
          "type": "string",
          "const": "Deliver to"
        },
        "recipientName": {
          "type": "string"
        },
        "city": {
          "type": "string",
          "examples": [
            "DALY CITY"
          ]
        }
      },
      "required": [
        "labelLine1",
        "recipientName",
        "city"
      ]
    },
    "searchTextInput": {
      "type": "object",
      "description": "Main search text input field in the header",
      "x-visibleCount": 1,
      "properties": {
        "type": {
          "const": "text"
        },
        "invalid": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ]
    },
    "searchSubmitButton": {
      "type": "object",
      "description": "Search icon button that submits the header search",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Search"
        },
        "invalid": {
          "type": "boolean"
        },
        "opensPage": {
          "const": "search_results"
        }
      },
      "required": [
        "ariaLabel"
      ]
    },
    "returnsAndOrdersLink": {
      "type": "object",
      "description": "Header link for Returns & Orders",
      "x-visibleCount": 1,
      "properties": {
        "line1": {
          "const": "Returns"
        },
        "line2": {
          "const": "& Orders"
        },
        "opensPage": {
          "const": "returns_and_orders"
        }
      },
      "required": [
        "line1",
        "line2"
      ]
    },
    "shoppingCartLink": {
      "type": "object",
      "description": "Header shopping cart control that opens the cart page",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Shopping Cart"
        },
        "itemCountLabel": {
          "type": "string",
          "examples": [
            "Cart has 0 items"
          ]
        },
        "label": {
          "const": "Cart"
        },
        "opensPage": {
          "const": "cart"
        }
      },
      "required": [
        "ariaLabel",
        "label"
      ]
    },
    "topNavCategoryName": {
      "type": "string",
      "enum": [
        "Gift",
        "Toy",
        "Home",
        "Gaming",
        "Cosmetic",
        "Headphones",
        "Coffee",
        "Kitchen"
      ]
    },
    "topNavCategoryLink": {
      "type": "object",
      "description": "Top navigation bar category labels (Gift, Toy, Home, etc.) that are visually separate clickable areas",
      "x-visibleCount": 8,
      "x-visibleCounts": {
        "Gift": 1,
        "Toy": 1,
        "Home": 1,
        "Gaming": 1,
        "Cosmetic": 1,
        "Headphones": 1,
        "Coffee": 1,
        "Kitchen": 1
      },
      "properties": {
        "categoryName": {
          "$ref": "#/$defs/topNavCategoryName"
        },
        "opensPage": {
          "const": "search_results"
        }
      },
      "required": [
        "categoryName"
      ]
    },
    "orderConfirmationSummarySection": {
      "type": "object",
      "description": "Non-interactive main confirmation box summarizing order placement and delivery",
      "x-visibleCount": 1,
      "properties": {
        "orderPlacedTitle": {
          "type": "string",
          "const": "Order placed, thanks!"
        },
        "confirmationNote": {
          "type": "string",
          "const": "Confirmation will be sent to your email."
        },
        "shippingLine": {
          "type": "string",
          "examples": [
            "Shipping to User, 4321 MISSION ST, DALY CITY, CA 94016-1234, United States"
          ]
        },
        "estimatedDeliveryDate": {
          "type": "string",
          "examples": [
            "Jul 19, 2024",
            "next-day, Nov 19, 2023"
          ]
        },
        "estimatedDeliveryLabel": {
          "type": "string",
          "const": "Estimated delivery"
        }
      },
      "required": [
        "orderPlacedTitle",
        "confirmationNote",
        "shippingLine",
        "estimatedDeliveryDate",
        "estimatedDeliveryLabel"
      ]
    },
    "reviewOrEditOrdersLink": {
      "type": "object",
      "description": "Clickable text link 'Review or edit your recent orders >'",
      "x-visibleCount": 1,
      "properties": {
        "text": {
          "type": "string",
          "const": "Review or edit your recent orders >"
        },
        "opensPage": {
          "const": "returns_and_orders"
        }
      },
      "required": [
        "text"
      ]
    },
    "footerBackToTopLink": {
      "type": "object",
      "description": "Centered 'Back to top' text that scrolls the page to the top",
      "x-visibleCount": 2,
      "properties": {
        "text": {
          "const": "Back to top"
        }
      },
      "required": [
        "text"
      ]
    },
    "footerNavLink": {
      "type": "object",
      "description": "Footer navigation text links under different footer headings",
      "x-visibleCount": 18,
      "x-visibleCounts": {
        "About Omnizon": 6,
        "Shopping": 4,
        "Account": 4,
        "Customer Service": 4
      },
      "properties": {
        "groupTitle": {
          "type": "string",
          "enum": [
            "About Omnizon",
            "Shopping",
            "Account",
            "Customer Service"
          ]
        },
        "text": {
          "type": "string",
          "enum": [
            "About Us",
            "Privacy Policy",
            "Terms of Service",
            "Browse Products",
            "Shopping Cart",
            "Your Orders",
            "Returns & Exchanges",
            "Help & Support",
            "Shipping Information",
            "Return Policy"
          ]
        }
      },
      "required": [
        "groupTitle",
        "text"
      ]
    }
  }
}