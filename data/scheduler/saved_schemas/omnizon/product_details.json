{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnizon Product Details Page Schema",
  "type": "object",
  "$defs": {
    "siteSectionTitle": {
      "type": "string",
      "description": "Titles of the visible content sections on the main page",
      "enum": [
        "Top categories in Kitchen appliances",
        "Gift for People!",
        "Shop for your home essentials",
        "Home d\u00e9cor under $50",
        "Refresh your space",
        "Shop deals in Fashion",
        "Get your game on",
        "Beauty steals under $25",
        "Top sellers in Kitchen",
        "Level up your beauty routine",
        "Wireless Tech",
        "Fantastic Finds for Home",
        "Explore more in Sports",
        "Top sellers in Technology"
      ]
    },
    "topNavCategoryName": {
      "type": "string",
      "enum": [
        "Gift",
        "Toy",
        "Home",
        "Gaming",
        "Cosmetic",
        "Headphones",
        "Coffee",
        "Kitchen"
      ]
    },
    "homeLogoLink": {
      "type": "object",
      "description": "Clickable Omnizon logo that navigates to the main page",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Home"
        },
        "opensPage": {
          "const": "main"
        }
      },
      "required": [
        "ariaLabel",
        "opensPage"
      ]
    },
    "deliveryLocationButton": {
      "type": "object",
      "description": "Clickable delivery location area showing recipient and city",
      "x-visibleCount": 1,
      "properties": {
        "labelLine1": {
          "type": "string",
          "const": "Deliver to"
        },
        "recipientName": {
          "type": "string"
        },
        "city": {
          "type": "string",
          "examples": [
            "DALY CITY"
          ]
        }
      },
      "required": [
        "labelLine1",
        "recipientName",
        "city"
      ]
    },
    "searchTextInput": {
      "type": "object",
      "description": "Main search text input field in the header",
      "x-visibleCount": 1,
      "properties": {
        "type": {
          "const": "text"
        },
        "invalid": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ]
    },
    "searchSubmitButton": {
      "type": "object",
      "description": "Search icon button that submits the header search",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Search"
        },
        "invalid": {
          "type": "boolean"
        },
        "opensPage": {
          "const": "search_results"
        }
      },
      "required": [
        "ariaLabel"
      ]
    },
    "returnsAndOrdersLink": {
      "type": "object",
      "description": "Header link for Returns & Orders",
      "x-visibleCount": 1,
      "properties": {
        "line1": {
          "const": "Returns"
        },
        "line2": {
          "const": "& Orders"
        },
        "opensPage": {
          "const": "returns_and_orders"
        }
      },
      "required": [
        "line1",
        "line2"
      ]
    },
    "shoppingCartLink": {
      "type": "object",
      "description": "Header shopping cart control that opens the cart page",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Shopping Cart"
        },
        "itemCountLabel": {
          "type": "string",
          "examples": [
            "Cart has 0 items"
          ]
        },
        "label": {
          "const": "Cart"
        },
        "opensPage": {
          "const": "cart"
        }
      },
      "required": [
        "ariaLabel",
        "label"
      ]
    },
    "topNavCategoryLink": {
      "type": "object",
      "description": "Top navigation bar category labels (Gift, Toy, Home, etc.) that are visually separate clickable areas",
      "x-visibleCount": 8,
      "x-visibleCounts": {
        "Gift": 1,
        "Toy": 1,
        "Home": 1,
        "Gaming": 1,
        "Cosmetic": 1,
        "Headphones": 1,
        "Coffee": 1,
        "Kitchen": 1
      },
      "properties": {
        "categoryName": {
          "$ref": "#/$defs/topNavCategoryName"
        },
        "opensPage": {
          "const": "search_results"
        }
      },
      "required": [
        "categoryName"
      ]
    },
    "productImageThumbnailButton": {
      "type": "object",
      "description": "Clickable thumbnail buttons to view a specific product image",
      "x-visibleCount": 5,
      "properties": {
        "role": {
          "const": "button"
        },
        "ariaLabel": {
          "type": "string",
          "examples": [
            "View image 1 of PlayStation DualSense\u00ae Wireless Controller - White"
          ]
        },
        "imageIndex": {
          "type": "integer"
        }
      },
      "required": [
        "role",
        "ariaLabel"
      ]
    },
    "productPrimaryInfo": {
      "type": "object",
      "description": "Non-clickable area showing main product information (title, rating, price, attributes)",
      "x-visibleCount": 1,
      "properties": {
        "productTitle": {
          "type": "string"
        },
        "ratingValue": {
          "type": "number"
        },
        "ratingCountLabel": {
          "type": "string"
        },
        "boughtInPastMonthLabel": {
          "type": "string"
        },
        "priceWhole": {
          "type": "string"
        },
        "priceFraction": {
          "type": "string"
        },
        "colorLabel": {
          "type": "string",
          "const": "Color:"
        },
        "colorValue": {
          "type": "string"
        },
        "brandLabel": {
          "type": "string",
          "const": "Brand"
        },
        "brandValue": {
          "type": "string"
        },
        "aboutThisItemTitle": {
          "type": "string",
          "const": "About this item"
        },
        "aboutThisItemBullets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "productTitle"
      ]
    },
    "buyBoxPrimaryPriceArea": {
      "type": "object",
      "description": "Non-clickable price and delivery info in the main Buy Box",
      "x-visibleCount": 1,
      "properties": {
        "priceWhole": {
          "type": "string"
        },
        "priceFraction": {
          "type": "string"
        },
        "deliveryLabelLine1": {
          "type": "string"
        },
        "deliveryLabelLine2": {
          "type": "string"
        },
        "deliveryThresholdNote": {
          "type": "string"
        },
        "shipToLocationLine": {
          "type": "string"
        },
        "stockStatus": {
          "type": "string",
          "examples": [
            "In Stock"
          ]
        }
      }
    },
    "quantityDropdown": {
      "type": "object",
      "description": "Quantity selection combobox in the Buy Box",
      "x-visibleCount": 1,
      "properties": {
        "role": {
          "const": "combobox"
        },
        "ariaExpanded": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "examples": [
            "Quantity: 1"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "role",
        "ariaExpanded"
      ]
    },
    "productAddToCartButton": {
      "type": "object",
      "description": "Yellow 'Add to Cart' button in the product buy box",
      "x-visibleCount": 1,
      "properties": {
        "text": {
          "const": "Add to Cart"
        },
        "ariaLabel": {
          "type": "string",
          "const": "Add to cart"
        },
        "invalid": {
          "type": "boolean"
        },
        "opensPage": {
          "const": "cart"
        }
      },
      "required": [
        "text",
        "ariaLabel"
      ]
    },
    "buyNowButton": {
      "type": "object",
      "description": "Orange 'Buy Now' button for direct purchase",
      "x-visibleCount": 1,
      "properties": {
        "text": {
          "const": "Buy Now"
        },
        "ariaLabel": {
          "type": "string",
          "const": "Buy now"
        },
        "invalid": {
          "type": "boolean"
        },
        "opensPage": {
          "const": "buy"
        }
      },
      "required": [
        "text",
        "ariaLabel"
      ]
    },
    "giftReceiptCheckbox": {
      "type": "object",
      "description": "Checkbox to add a gift receipt for easy returns",
      "x-visibleCount": 1,
      "properties": {
        "labelText": {
          "type": "string",
          "const": "Add a gift receipt for easy returns"
        },
        "checked": {
          "type": "boolean"
        }
      },
      "required": [
        "labelText",
        "checked"
      ]
    },
    "saveWithUsedPriceArea": {
      "type": "object",
      "description": "Non-clickable area describing the used-like-new offer",
      "x-visibleCount": 1,
      "properties": {
        "sectionTitle": {
          "type": "string",
          "const": "Save with Used - Like new:"
        },
        "priceWhole": {
          "type": "string"
        },
        "priceFraction": {
          "type": "string"
        },
        "deliveryLabelLine1": {
          "type": "string"
        },
        "deliveryLabelLine2": {
          "type": "string"
        },
        "shipsFrom": {
          "type": "string"
        },
        "soldBy": {
          "type": "string"
        }
      },
      "required": [
        "sectionTitle"
      ]
    },
    "productDescriptionSection": {
      "type": "object",
      "description": "Non-interactive product description text block under 'Product description' heading",
      "x-visibleCount": 1,
      "properties": {
        "sectionTitle": {
          "type": "string",
          "const": "Product description"
        },
        "bodyText": {
          "type": "string"
        }
      },
      "required": [
        "sectionTitle",
        "bodyText"
      ]
    },
    "customerReviewsSummarySection": {
      "type": "object",
      "description": "Non-interactive summary of customer reviews including average rating and distribution bars",
      "x-visibleCount": 1,
      "properties": {
        "sectionTitle": {
          "type": "string",
          "const": "Customer reviews"
        },
        "averageRatingValue": {
          "type": "number"
        },
        "averageRatingText": {
          "type": "string",
          "examples": [
            "4.5 out of 5"
          ]
        },
        "totalGlobalRatingsLabel": {
          "type": "string"
        },
        "ratingBreakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "starLabel": {
                "type": "string"
              },
              "percentage": {
                "type": "string"
              }
            },
            "required": [
              "starLabel",
              "percentage"
            ]
          }
        }
      },
      "required": [
        "sectionTitle",
        "averageRatingValue"
      ]
    },
    "writeReviewButton": {
      "type": "object",
      "description": "Button to write a product review under 'Review this product'",
      "x-visibleCount": 1,
      "properties": {
        "text": {
          "const": "Write a product review"
        },
        "invalid": {
          "type": "boolean"
        },
        "opensPage": {
          "const": "review"
        }
      },
      "required": [
        "text"
      ]
    },
    "customerReviewCard": {
      "type": "object",
      "description": "Individual customer review entry in the 'Customer Say' section",
      "x-visibleCount": 2,
      "properties": {
        "sectionTitle": {
          "type": "string",
          "const": "Customer Say"
        },
        "reviewerName": {
          "type": "string"
        },
        "starRatingAriaLabel": {
          "type": "string",
          "examples": [
            "5 Stars",
            "4 Stars"
          ]
        },
        "reviewTitle": {
          "type": "string"
        },
        "reviewDate": {
          "type": "string"
        },
        "verifiedPurchaseLabel": {
          "type": "string",
          "const": "Verified Purchase"
        },
        "reviewBody": {
          "type": "string"
        }
      },
      "required": [
        "sectionTitle",
        "reviewerName",
        "reviewBody"
      ]
    },
    "relatedTabButton": {
      "type": "object",
      "description": "Tab buttons in the Related Products & Recommendations section",
      "x-visibleCount": 4,
      "x-visibleCounts": {
        "Similar Items": 1,
        "Customers Also Viewed": 1,
        "Trending Now": 1,
        "New Arrivals": 1
      },
      "properties": {
        "role": {
          "const": "tab"
        },
        "text": {
          "type": "string",
          "enum": [
            "Similar Items",
            "Customers Also Viewed",
            "Trending Now",
            "New Arrivals"
          ]
        },
        "selected": {
          "type": "boolean"
        }
      },
      "required": [
        "role",
        "text",
        "selected"
      ]
    }
  }
}