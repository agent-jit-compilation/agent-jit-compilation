{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnizon Cancellation Page Schema",
  "type": "object",
  "properties": {
    "page": {
      "const": "cancellation"
    }
  },
  "required": [
    "page"
  ],
  "$defs": {
    "siteSectionTitle": {
      "type": "string",
      "description": "Titles of the visible content sections on the main page",
      "enum": [
        "Top categories in Kitchen appliances",
        "Gift for People!",
        "Shop for your home essentials",
        "Home d\u00e9cor under $50",
        "Refresh your space",
        "Shop deals in Fashion",
        "Get your game on",
        "Beauty steals under $25",
        "Top sellers in Kitchen",
        "Level up your beauty routine",
        "Wireless Tech",
        "Fantastic Finds for Home",
        "Explore more in Sports",
        "Top sellers in Technology"
      ]
    },
    "topNavCategoryName": {
      "type": "string",
      "enum": [
        "Gift",
        "Toy",
        "Home",
        "Gaming",
        "Cosmetic",
        "Headphones",
        "Coffee",
        "Kitchen"
      ]
    },
    "homeLogoLink": {
      "type": "object",
      "description": "Clickable Omnizon logo that navigates to the main page",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Home"
        },
        "opensPage": {
          "const": "main"
        }
      },
      "required": [
        "ariaLabel",
        "opensPage"
      ]
    },
    "deliveryLocationButton": {
      "type": "object",
      "description": "Clickable delivery location area showing recipient and city",
      "x-visibleCount": 1,
      "properties": {
        "labelLine1": {
          "type": "string",
          "const": "Deliver to"
        },
        "recipientName": {
          "type": "string"
        },
        "city": {
          "type": "string",
          "examples": [
            "DALY CITY"
          ]
        }
      },
      "required": [
        "labelLine1",
        "recipientName",
        "city"
      ]
    },
    "searchTextInput": {
      "type": "object",
      "description": "Main search text input field in the header",
      "x-visibleCount": 1,
      "properties": {
        "type": {
          "const": "text"
        },
        "invalid": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ]
    },
    "searchSubmitButton": {
      "type": "object",
      "description": "Search icon button that submits the header search",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Search"
        },
        "invalid": {
          "type": "boolean"
        },
        "opensPage": {
          "const": "search_results"
        }
      },
      "required": [
        "ariaLabel"
      ]
    },
    "returnsAndOrdersLink": {
      "type": "object",
      "description": "Header link for Returns & Orders",
      "x-visibleCount": 1,
      "properties": {
        "line1": {
          "const": "Returns"
        },
        "line2": {
          "const": "& Orders"
        },
        "opensPage": {
          "const": "returns_and_orders"
        }
      },
      "required": [
        "line1",
        "line2"
      ]
    },
    "shoppingCartLink": {
      "type": "object",
      "description": "Header shopping cart control that opens the cart page",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Shopping Cart"
        },
        "itemCountLabel": {
          "type": "string"
        },
        "label": {
          "const": "Cart"
        },
        "opensPage": {
          "const": "cart"
        }
      },
      "required": [
        "ariaLabel",
        "label"
      ]
    },
    "topNavCategoryLink": {
      "type": "object",
      "description": "Top navigation bar category labels (Gift, Toy, Home, etc.) that are visually separate clickable areas",
      "x-visibleCount": 8,
      "x-visibleCounts": {
        "Gift": 1,
        "Toy": 1,
        "Home": 1,
        "Gaming": 1,
        "Cosmetic": 1,
        "Headphones": 1,
        "Coffee": 1,
        "Kitchen": 1
      },
      "properties": {
        "categoryName": {
          "$ref": "#/$defs/topNavCategoryName"
        },
        "opensPage": {
          "const": "search_results"
        }
      },
      "required": [
        "categoryName"
      ]
    },
    "cancellationOrderSummaryHeader": {
      "type": "object",
      "description": "Non-interactive summary row for the order being cancelled showing placement date, total, ship to, and order number",
      "x-visibleCount": 1,
      "properties": {
        "pageContext": {
          "type": "string",
          "const": "Cancel Order"
        },
        "orderPlacedLabel": {
          "type": "string",
          "const": "ORDER PLACED"
        },
        "orderPlacedDate": {
          "type": "string"
        },
        "totalLabel": {
          "type": "string",
          "const": "TOTAL"
        },
        "totalValue": {
          "type": "string"
        },
        "shipToLabel": {
          "type": "string",
          "const": "SHIP TO"
        },
        "shipToName": {
          "type": "string"
        },
        "orderNumberLabel": {
          "type": "string",
          "const": "ORDER #"
        },
        "orderNumberValue": {
          "type": "string"
        }
      },
      "required": [
        "pageContext",
        "orderPlacedLabel",
        "orderPlacedDate",
        "totalLabel",
        "totalValue",
        "shipToLabel",
        "shipToName",
        "orderNumberLabel",
        "orderNumberValue"
      ]
    },
    "cancellationOrderItemCard": {
      "type": "object",
      "description": "Non-clickable area within the cancellation page showing a single product from the order, including title, seller and price/quantity",
      "x-visibleCount": 2,
      "properties": {
        "productTitle": {
          "type": "string"
        },
        "soldByLabel": {
          "type": "string",
          "const": "Sold by:"
        },
        "sellerName": {
          "type": "string"
        },
        "priceAndQuantity": {
          "type": "string"
        }
      },
      "required": [
        "productTitle",
        "soldByLabel",
        "sellerName",
        "priceAndQuantity"
      ]
    },
    "ordersWriteReviewButton": {
      "type": "object",
      "description": "Buttons labeled 'Write a product review' shown for each purchased or cancelled item",
      "x-visibleCount": 2,
      "properties": {
        "text": {
          "const": "Write a product review"
        },
        "invalid": {
          "type": "boolean"
        },
        "productTitle": {
          "type": "string"
        },
        "opensPage": {
          "const": "review"
        }
      },
      "required": [
        "text"
      ]
    },
    "cancellationTotalRefundSummary": {
      "type": "object",
      "description": "Non-interactive line showing the total refund amount for the cancellation (pre-confirmation view)",
      "x-visibleCount": 1,
      "properties": {
        "label": {
          "type": "string",
          "const": "Total Refund:"
        },
        "amount": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "amount"
      ]
    },
    "cancellationReasonCombobox": {
      "type": "object",
      "description": "Dropdown combobox for selecting an optional cancellation reason",
      "x-visibleCount": 1,
      "properties": {
        "role": {
          "const": "combobox"
        },
        "ariaExpanded": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string",
          "const": "Cancellation reason (optional)"
        }
      },
      "required": [
        "role",
        "ariaExpanded",
        "required",
        "placeholder"
      ]
    },
    "cancellationSubmitButton": {
      "type": "object",
      "description": "Yellow button labeled 'Cancel Order' that submits the cancellation request",
      "x-visibleCount": 1,
      "properties": {
        "type": {
          "const": "button"
        },
        "ariaLabel": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "const": "Cancel Order"
        },
        "invalid": {
          "type": "boolean"
        },
        "orderNumberValue": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    "cancellationConfirmationPanel": {
      "type": "object",
      "description": "Non-interactive confirmation panel shown after an order is cancelled",
      "x-visibleCount": 1,
      "properties": {
        "title": {
          "type": "string",
          "const": "Cancellation Confirmed!"
        },
        "confirmationNote": {
          "type": "string",
          "const": "Confirmation will be sent to your email."
        },
        "cancellationNumberLabel": {
          "type": "string",
          "const": "Cancellation Number:"
        },
        "cancellationNumberValue": {
          "type": "string"
        },
        "totalRefundLabel": {
          "type": "string",
          "const": "Total Refund:"
        },
        "totalRefundAmount": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "confirmationNote",
        "cancellationNumberLabel",
        "cancellationNumberValue",
        "totalRefundLabel",
        "totalRefundAmount"
      ]
    },
    "cancellationBuyOtherProductsLink": {
      "type": "object",
      "description": "Text link 'Buy other products >' in the cancellation confirmation panel",
      "x-visibleCount": 1,
      "properties": {
        "text": {
          "type": "string",
          "const": "Buy other products >"
        },
        "opensPage": {
          "const": "main"
        }
      },
      "required": [
        "text"
      ]
    },
    "cancellationSeeMyOrdersLink": {
      "type": "object",
      "description": "Text link 'See my orders >' in the cancellation confirmation panel",
      "x-visibleCount": 1,
      "properties": {
        "text": {
          "type": "string",
          "const": "See my orders >"
        },
        "opensPage": {
          "const": "returns_and_orders"
        }
      },
      "required": [
        "text"
      ]
    },
    "footerBackToTopLink": {
      "type": "object",
      "description": "Centered 'Back to top' text that scrolls the page to the top",
      "x-visibleCount": 2,
      "properties": {
        "text": {
          "const": "Back to top"
        }
      },
      "required": [
        "text"
      ]
    },
    "footerNavLink": {
      "type": "object",
      "description": "Footer navigation text links under different footer headings",
      "x-visibleCount": 18,
      "x-visibleCounts": {
        "About Omnizon": 6,
        "Shopping": 4,
        "Account": 4,
        "Customer Service": 4
      },
      "properties": {
        "groupTitle": {
          "type": "string",
          "enum": [
            "About Omnizon",
            "Shopping",
            "Account",
            "Customer Service"
          ]
        },
        "text": {
          "type": "string",
          "enum": [
            "About Us",
            "Privacy Policy",
            "Terms of Service",
            "Browse Products",
            "Shopping Cart",
            "Your Orders",
            "Returns & Exchanges",
            "Help & Support",
            "Shipping Information",
            "Return Policy"
          ]
        }
      },
      "required": [
        "groupTitle",
        "text"
      ]
    }
  }
}