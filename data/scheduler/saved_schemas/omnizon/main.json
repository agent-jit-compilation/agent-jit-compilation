{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnizon Main Page Schema",
  "type": "object",
  "description": "Schema describing actionable elements on the Omnizon main page, based only on visible content.",
  "$defs": {
    "siteSectionTitle": {
      "type": "string",
      "description": "Titles of the visible content sections on the main page",
      "enum": [
        "Top categories in Kitchen appliances",
        "Gift for People!",
        "Shop for your home essentials",
        "Home d\u00e9cor under $50",
        "Refresh your space",
        "Shop deals in Fashion",
        "Get your game on",
        "Beauty steals under $25",
        "Top sellers in Kitchen",
        "Level up your beauty routine",
        "Wireless Tech",
        "Fantastic Finds for Home",
        "Explore more in Sports",
        "Top sellers in Technology"
      ]
    },
    "topNavCategoryName": {
      "type": "string",
      "enum": [
        "Gift",
        "Toy",
        "Home",
        "Gaming",
        "Cosmetic",
        "Headphones",
        "Coffee",
        "Kitchen"
      ]
    },
    "homeLogoLink": {
      "type": "object",
      "description": "Clickable Omnizon logo that navigates to the main page",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Home"
        },
        "opensPage": {
          "const": "main"
        }
      },
      "required": [
        "ariaLabel",
        "opensPage"
      ]
    },
    "deliveryLocationButton": {
      "type": "object",
      "description": "Clickable delivery location area showing recipient and city",
      "x-visibleCount": 1,
      "properties": {
        "labelLine1": {
          "type": "string",
          "const": "Deliver to"
        },
        "recipientName": {
          "type": "string"
        },
        "city": {
          "type": "string",
          "examples": [
            "DALY CITY"
          ]
        }
      },
      "required": [
        "labelLine1",
        "recipientName",
        "city"
      ]
    },
    "searchTextInput": {
      "type": "object",
      "description": "Main search text input field in the header",
      "x-visibleCount": 1,
      "properties": {
        "type": {
          "const": "text"
        },
        "invalid": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ]
    },
    "searchSubmitButton": {
      "type": "object",
      "description": "Search icon button that submits the header search",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Search"
        },
        "invalid": {
          "type": "boolean"
        },
        "opensPage": {
          "const": "search_results"
        }
      },
      "required": [
        "ariaLabel"
      ]
    },
    "returnsAndOrdersLink": {
      "type": "object",
      "description": "Header link for Returns & Orders",
      "x-visibleCount": 1,
      "properties": {
        "line1": {
          "const": "Returns"
        },
        "line2": {
          "const": "& Orders"
        },
        "opensPage": {
          "const": "returns_and_orders"
        }
      },
      "required": [
        "line1",
        "line2"
      ]
    },
    "shoppingCartLink": {
      "type": "object",
      "description": "Header shopping cart control that opens the cart page",
      "x-visibleCount": 1,
      "properties": {
        "ariaLabel": {
          "const": "Shopping Cart"
        },
        "itemCountLabel": {
          "type": "string",
          "examples": [
            "Cart has 0 items"
          ]
        },
        "label": {
          "const": "Cart"
        },
        "opensPage": {
          "const": "cart"
        }
      },
      "required": [
        "ariaLabel",
        "label"
      ]
    },
    "topNavCategoryLink": {
      "type": "object",
      "description": "Top navigation bar category labels (Gift, Toy, Home, etc.) that are visually separate clickable areas",
      "x-visibleCount": 8,
      "x-visibleCounts": {
        "Gift": 1,
        "Toy": 1,
        "Home": 1,
        "Gaming": 1,
        "Cosmetic": 1,
        "Headphones": 1,
        "Coffee": 1,
        "Kitchen": 1
      },
      "properties": {
        "categoryName": {
          "$ref": "#/$defs/topNavCategoryName"
        },
        "opensPage": {
          "const": "search_results"
        }
      },
      "required": [
        "categoryName"
      ]
    },
    "heroCarouselPreviousButton": {
      "type": "object",
      "description": "Previous slide control for the large hero banner carousel",
      "x-visibleCount": 1,
      "properties": {
        "role": {
          "const": "button"
        },
        "ariaLabel": {
          "const": "Previous slide"
        }
      },
      "required": [
        "role",
        "ariaLabel"
      ]
    },
    "heroCarouselNextButton": {
      "type": "object",
      "description": "Next slide control for the large hero banner carousel",
      "x-visibleCount": 1,
      "properties": {
        "role": {
          "const": "button"
        },
        "ariaLabel": {
          "const": "Next slide"
        }
      },
      "required": [
        "role",
        "ariaLabel"
      ]
    },
    "sectionCategoryCard": {
      "type": "object",
      "description": "Clickable image tiles inside multi-tile promotional sections (e.g., Cleaning Tools, Jeans under $50)",
      "x-visibleCount": 44,
      "x-visibleCounts": {
        "Top categories in Kitchen appliances": 4,
        "Shop for your home essentials": 4,
        "Refresh your space": 4,
        "Shop deals in Fashion": 4,
        "Level up your beauty routine": 4,
        "Wireless Tech": 4,
        "Fantastic Finds for Home": 4,
        "Explore more in Sports": 4,
        "Get your game on": 1,
        "Beauty steals under $25": 1,
        "Gift for People!": 1,
        "Home d\u00e9cor under $50": 1,
        "Home d\u00e9cor under $50 (image only group)": 1,
        "Top sellers in Kitchen": 5,
        "Top sellers in Technology": 5,
        "Home d\u00e9cor under $50 (D\u00e9cor Category preview)": 1,
        "Get your game on (Gaming Category preview)": 1,
        "Beauty steals under $25 (Beauty Category preview)": 1
      },
      "properties": {
        "sectionTitle": {
          "$ref": "#/$defs/siteSectionTitle"
        },
        "ariaLabel": {
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "opensPage": {
          "const": "search_results"
        }
      }
    },
    "sectionPrimaryLink": {
      "type": "object",
      "description": "Primary call-to-action text links at the bottom of cards (e.g., Explore all products in Kitchen, Learn more, Shop now, See more)",
      "x-visibleCount": 11,
      "x-visibleCounts": {
        "Top categories in Kitchen appliances": 1,
        "Gift for People!": 1,
        "Shop for your home essentials": 1,
        "Home d\u00e9cor under $50": 1,
        "Refresh your space": 1,
        "Shop deals in Fashion": 1,
        "Get your game on": 1,
        "Beauty steals under $25": 1,
        "Level up your beauty routine": 1,
        "Wireless Tech": 1,
        "Fantastic Finds for Home": 1,
        "Explore more in Sports": 1
      },
      "properties": {
        "sectionTitle": {
          "$ref": "#/$defs/siteSectionTitle"
        },
        "text": {
          "type": "string",
          "enum": [
            "Explore all products in Kitchen",
            "Learn more",
            "Discover more in Home",
            "Shop now",
            "See more",
            "See all deals",
            "Shop gaming",
            "Discover more",
            "Explore more"
          ]
        },
        "ariaLabel": {
          "type": "string"
        },
        "opensPage": {
          "const": "search_results"
        }
      }
    },
    "topSellersKitchenNextSlideButton": {
      "type": "object",
      "description": "Next slide button for the 'Top sellers in Kitchen' horizontal scroller",
      "x-visibleCount": 1,
      "properties": {
        "role": {
          "const": "button"
        },
        "ariaLabel": {
          "const": "Next slide"
        }
      },
      "required": [
        "role",
        "ariaLabel"
      ]
    }
  }
}